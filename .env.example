# Shared settings for running the services on the host (npm run start:dev).
# Each service also reads apps/<service>/.env (copy apps/<service>/.env.example); values there win.

# --- App ---
NODE_ENV=development
API_PREFIX=api/v1
LOG_LEVEL=debug
API_DOCS_ENABLED=true

# --- Database (each service has its own database; see apps/<service>/.env) ---
DB_HOST=localhost
DB_PORT=5432
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false
DB_RUN_MIGRATIONS=true

# --- Kafka ---
KAFKA_BROKERS=localhost:9092

# --- Auth (same secret everywhere: identity signs, every service verifies) ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# --- Gateway ---
CORS_ORIGINS=http://localhost:4200
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Seed (initial admin, used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@cargo.local
SEED_ADMIN_PASSWORD=DevAdmin123!
