# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
LOG_LEVEL=debug
SWAGGER_ENABLED=true

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=cargo
DB_PASSWORD=cargo_dev_password
DB_NAME=cargo
DB_SSL=false
DB_POOL_MAX=10
DB_LOGGING=false
DB_RUN_MIGRATIONS=true

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1h

# --- Rate limiting ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# --- Seed (initial admin, used by `npm run seed`) ---
SEED_ADMIN_EMAIL=admin@cargo.local
SEED_ADMIN_PASSWORD=DevAdmin123!
