{
  "name": "cargo-api",
  "version": "1.0.0",
  "description": "Air & sea cargo / freight forwarding backend: NestJS microservices (gateway, identity, master-data, shipments) with PostgreSQL and Kafka",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nest build gateway && nest build identity && nest build master-data && nest build shipments",
    "start:dev": "concurrently -k -n gateway,identity,master,shipments -c cyan,magenta,yellow,green \"nest start gateway --watch\" \"nest start identity --watch\" \"nest start master-data --watch\" \"nest start shipments --watch\"",
    "start:debug": "nest start --debug --watch",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand",
    "typeorm": "ts-node -r tsconfig-paths/register node_modules/typeorm/cli.js",
    "migration:run": "npm run migration:run:identity && npm run migration:run:master-data && npm run migration:run:shipments",
    "migration:run:identity": "npm run typeorm -- migration:run -d apps/identity/src/database/data-source.ts",
    "migration:revert:identity": "npm run typeorm -- migration:revert -d apps/identity/src/database/data-source.ts",
    "migration:generate:identity": "npm run typeorm -- migration:generate -d apps/identity/src/database/data-source.ts",
    "migration:run:master-data": "npm run typeorm -- migration:run -d apps/master-data/src/database/data-source.ts",
    "migration:revert:master-data": "npm run typeorm -- migration:revert -d apps/master-data/src/database/data-source.ts",
    "migration:generate:master-data": "npm run typeorm -- migration:generate -d apps/master-data/src/database/data-source.ts",
    "migration:run:shipments": "npm run typeorm -- migration:run -d apps/shipments/src/database/data-source.ts",
    "migration:revert:shipments": "npm run typeorm -- migration:revert -d apps/shipments/src/database/data-source.ts",
    "migration:generate:shipments": "npm run typeorm -- migration:generate -d apps/shipments/src/database/data-source.ts",
    "seed": "npm run seed:identity && npm run seed:master-data",
    "seed:identity": "ts-node -r tsconfig-paths/register apps/identity/src/database/seed.ts",
    "seed:master-data": "ts-node -r tsconfig-paths/register apps/master-data/src/database/seed.ts",
    "masterdata:republish": "ts-node -r tsconfig-paths/register apps/master-data/src/database/seed.ts --republish",
    "schedules:recompute": "ts-node -r tsconfig-paths/register apps/shipments/src/database/recompute-schedules.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "@nestjs/throttler": "^6.3.0",
    "@nestjs/typeorm": "^10.0.2",
    "@scalar/nestjs-api-reference": "^1.2.41",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.7.5",
    "dotenv": "^16.6.1",
    "helmet": "^8.0.0",
    "http-proxy-middleware": "^3.0.11",
    "joi": "^17.13.3",
    "js-yaml": "^4.3.2",
    "kafkajs": "^2.2.4",
    "luxon": "^3.7.2",
    "nestjs-pino": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "concurrently": "^10.0.7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "roots": [
      "<rootDir>/apps",
      "<rootDir>/libs"
    ],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "{apps,libs}/**/*.(t|j)s",
      "!**/migrations/**",
      "!**/main.ts"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "globalSetup": "<rootDir>/test/global-setup.ts",
    "moduleNameMapper": {
      "^@cargo/common(|/.*)$": "<rootDir>/libs/common/src$1",
      "^@cargo/messaging(|/.*)$": "<rootDir>/libs/messaging/src$1"
    }
  }
}
