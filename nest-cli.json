{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/gateway",
  "sourceRoot": "apps/gateway/src",
  "compilerOptions": {
    "builder": "tsc",
    "webpack": false,
    "deleteOutDir": true,
    "tsConfigPath": "apps/gateway/tsconfig.app.json",
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": { "classValidatorShim": true, "introspectComments": true }
      }
    ]
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": { "tsConfigPath": "apps/gateway/tsconfig.app.json" }
    },
    "identity": {
      "type": "application",
      "root": "apps/identity",
      "entryFile": "main",
      "sourceRoot": "apps/identity/src",
      "compilerOptions": { "tsConfigPath": "apps/identity/tsconfig.app.json" }
    },
    "master-data": {
      "type": "application",
      "root": "apps/master-data",
      "entryFile": "main",
      "sourceRoot": "apps/master-data/src",
      "compilerOptions": { "tsConfigPath": "apps/master-data/tsconfig.app.json" }
    },
    "shipments": {
      "type": "application",
      "root": "apps/shipments",
      "entryFile": "main",
      "sourceRoot": "apps/shipments/src",
      "compilerOptions": { "tsConfigPath": "apps/shipments/tsconfig.app.json" }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": { "tsConfigPath": "libs/common/tsconfig.lib.json" }
    },
    "messaging": {
      "type": "library",
      "root": "libs/messaging",
      "entryFile": "index",
      "sourceRoot": "libs/messaging/src",
      "compilerOptions": { "tsConfigPath": "libs/messaging/tsconfig.lib.json" }
    }
  }
}
